# ==========================================================
# Exemplo de variáveis de ambiente — copie para ".env" e preencha
# (o arquivo .env NUNCA deve ser commitado)
# ==========================================================

# --- Supabase (obrigatório para o painel admin funcionar) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# --- Google Tag Manager (opção 1 — recomendado) ---
# Container do GTM. Formato: GTM-XXXXXXX
# Obtenha em: https://tagmanager.google.com
# Com GTM configurado, as tags de GA4/Clarity são gerenciadas pelo painel do Google.
VITE_GTM_ID=

# --- Google Analytics 4 (opção 2 — uso direto, sem GTM) ---
# ID de medição do GA4. Formato: G-XXXXXXXXXX
# Obtenha em: https://analytics.google.com > Admin > Fluxos de dados
VITE_GA4_MEASUREMENT_ID=

# --- Microsoft Clarity (opção 3 — uso direto, sem GTM) ---
# ID do projeto Clarity (cadeia de letras/números, ex: "abcdefghij")
# Obtenha em: https://clarity.microsoft.com > Configurações > ID do projeto
VITE_CLARITY_PROJECT_ID=

# Regra: se VITE_GTM_ID estiver preenchido, ele tem prioridade e as
# opções 2/3 são ignoradas (configure as tags dentro do container GTM).
